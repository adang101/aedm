# Copy to .env. Never commit .env.
ANTHROPIC_API_KEY=
# fake | anthropic. "fake" uses the scripted offline DM (no API key needed).
AEDM_LLM_PROVIDER=fake
AEDM_PORT=8787
# Where saves go (default: data/saves under the repo root).
# AEDM_SAVE_DIR=
# Set to 1 to log DM actions the engine rejected.
# AEDM_DEV_LOG=0
