# Copy to .env. Never commit .env.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# fake | gemini | anthropic. "fake" uses the scripted offline DM (no API key needed).
AEDM_LLM_PROVIDER=fake
AEDM_PORT=8787
# Where saves and accounts live (default: data/ under the repo root; accounts in <data>/accounts).
# AEDM_DATA_DIR=
# Where saves go (default: <data>/saves).
# AEDM_SAVE_DIR=
# Set to 1 to log DM actions the engine rejected.
# AEDM_DEV_LOG=0
