{
  "name": "aedm",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "dev:server": "pnpm --filter @aedm/server dev",
    "dev:web": "pnpm --filter @aedm/web dev",
    "eval": "pnpm --filter @aedm/evals eval",
    "build:web": "pnpm --filter @aedm/web build",
    "dev:edge": "pnpm build:web && pnpm --filter @aedm/edge dev",
    "deploy:edge": "pnpm build:web && pnpm --filter @aedm/edge deploy"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.10.0",
    "eslint": "^10.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.1.0"
  }
}
